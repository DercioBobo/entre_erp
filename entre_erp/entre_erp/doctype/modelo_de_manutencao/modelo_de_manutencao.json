   "depends_on": "enviar_lembrete",
   "fieldname": "hora_do_lembrete",
   "fieldtype": "Time",
   "label": "Hora do lembrete"
  },
  {
   "fieldname": "section_janela",
   "fieldtype": "Section Break",
   "label": "Janela habitual"
  },
  {
   "fieldname": "janela",
   "fieldtype": "HTML",
   "label": "Janela"
  },
  {
   "default": "21:00:00",
   "fieldname": "hora_inicio",
   "fieldtype": "Time",
   "label": "Hora de início",
   "reqd": 1
  },
  {
   "default": "04:00:00",
   "description": "Antes da hora de início = no dia seguinte.",
   "fieldname": "hora_fim",
   "fieldtype": "Time",
   "label": "Hora de fim",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.tipo==\"Preventiva\"",
   "fieldname": "section_recorrencia",
   "fieldtype": "Section Break",
   "label": "Recorrência"
  },
  {
   "description": "Em branco: sem repetição, as manutenções são criadas à mão.",
   "fieldname": "periodicidade",
   "fieldtype": "Select",
   "label": "Periodicidade",
   "options": "\nSemanal\nQuinzenal\nMensal\nBimestral\nTrimestral\nSemestral\nAnual"
  },
  {
   "default": "Mesmo dia do mês",
   "depends_on": "eval:doc.periodicidade && ![\"Semanal\", \"Quinzenal\"].includes(doc.periodicidade)",
   "fieldname": "regra_mensal",
   "fieldtype": "Select",
   "label": "Repetir no",
   "options": "Mesmo dia do mês\nMesmo dia da semana (ex.: 2ª terça-feira)"
  },
  {
   "depends_on": "periodicidade",
   "description": "As seguintes contam a partir desta data.",
   "fieldname": "comeca_em",
   "fieldtype": "Date",
   "label": "Primeira manutenção",
   "mandatory_depends_on": "periodicidade"
  },
  {
   "default": "7",
   "depends_on": "periodicidade",
   "description": "A manutenção é criada estes dias antes; o aviso sai nesse dia se agendar automaticamente.",
   "fieldname": "dias_de_antecedencia",
   "fieldtype": "Int",
   "label": "Criar com antecedência (dias)"
  },
  {
   "default": "1",
   "depends_on": "periodicidade",
   "description": "Desligado: a manutenção fica em Rascunho para rever e agendar à mão.",
   "fieldname": "agendar_automaticamente",
   "fieldtype": "Check",
   "label": "Agendar e enviar o aviso automaticamente"
  },
  {
   "fieldname": "column_break_recorrencia",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "periodicidade",
